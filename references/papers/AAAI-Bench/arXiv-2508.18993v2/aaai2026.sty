\makeatletter

% Flags + storage
\newif\ifaaai@hasfrontabs     \aaai@hasfrontabsfalse
\newif\ifaaai@hasfrontteaser  \aaai@hasfrontteaserfalse
\def\aaai@frontabstract{}
\def\aaai@frontteaser{}

% Public macros for authors to set content BEFORE \maketitle
\long\def\frontabstract#1{\gdef\aaai@frontabstract{#1}\aaai@hasfrontabstrue}
\long\def\frontteaser#1{\gdef\aaai@frontteaser{#1}\aaai@hasfrontteasertrue}

% Fallback \captionof if not provided by caption/capt-of
\providecommand{\captionof}[2]{%
  \refstepcounter{#1}%
  \par\noindent\small\bfseries \csname fnum@#1\endcsname\space #2\par
}

% Builder: inject right after title/authors inside the two-column top box
\def\aaai@frontblock{%
  \ifaaai@hasfrontabs
    \par\centerline{\bf Abstract}\vspace{0.5ex}%
    \begin{quote}\small \aaai@frontabstract\end{quote}\vskip 1ex%
  \fi
  \ifaaai@hasfrontteaser
    \par\begingroup\centering \aaai@frontteaser \par\endgroup \vskip 1ex%
  \fi
}

% Patch \maketitle: typeset \@maketitle + our front block in the first-page top box
\renewcommand\maketitle{%
  \par
  \begingroup
    \def\thefootnote{\fnsymbol{footnote}}%
    \twocolumn[{%
      \@maketitle
      \aaai@frontblock
    }]%
    \@thanks
  \endgroup
  \if T\copyright@on
    \insert\footins{\noindent\footnotesize\copyright@text}%
  \fi
  \setcounter{footnote}{0}%
  \let\maketitle\relax
  \let\@maketitle\relax
  \gdef\@thanks{}%
  \gdef\@author{}%
  \gdef\@title{}%
  \let\thanks\relax
}

\makeatother
%% === PATCH END ===

% === UPDATE: configurable Abstract margins ===
\makeatletter

% 1) 两个可配置的边距量，默认和 quote 环境差不多
\newdimen\aaai@absleft
\newdimen\aaai@absright
\aaai@absleft=10pt
\aaai@absright=10pt

% 2) 给作者用的设置命令：\setfrontabstractmargins{<left>}{<right>}
\newcommand{\setfrontabstractmargins}[2]{%
  \aaai@absleft=#1\relax
  \aaai@absright=#2\relax
}

% 3) 替换你补丁里 \aaai@frontblock 中“Abstract 输出”的那一段：
%    原来是：
%      \par\centerline{\bf Abstract}\vspace{0.5ex}%
%      \begin{quote}\small \aaai@frontabstract\end{quote}\vskip 1ex%
%    改成下面这段（自定义左右边距的 list 方案）：
\def\aaai@frontblock{%
  \ifaaai@hasfrontabs
    \par\centerline{\bf Abstract}\vspace{0.5ex}%
    {\small
      \list{}{\leftmargin\aaai@absleft \rightmargin\aaai@absright}\item[]
      \aaai@frontabstract
      \endlist
    }%
    \vskip 1ex%
  \fi
  \ifaaai@hasfrontteaser
    \par\begingroup\centering \aaai@frontteaser \par\endgroup \vskip 1ex%
  \fi
}

\makeatother
% === END UPDATE ===

