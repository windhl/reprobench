% === UPDATE 4+5: 摘要框精确水平定位 + 圆角边框（合并版） ===
\makeatletter

% 依赖（AAAI 未禁）：tikz 画圆角；如未加载则自动加载
\@ifpackageloaded{tikz}{}{\RequirePackage{tikz}}
\@ifpackageloaded{xcolor}{}{\RequirePackage{xcolor}}

% 若未定义边框颜色名，给默认蓝紫 #6A5ACD
\@ifundefined{AAAIFrontAbsBorder}{\definecolor{AAAIFrontAbsBorder}{RGB}{106,90,205}}{}

% 可能外部已定义的参数，这里给兜底默认值，避免未定义时报错
\@ifundefined{aaai@absleft}{\newdimen\aaai@absleft \aaai@absleft=10pt}{}
\@ifundefined{aaai@absright}{\newdimen\aaai@absright \aaai@absright=10pt}{}
\@ifundefined{aaai@absboxsep}{\newlength\aaai@absboxsep \setlength{\aaai@absboxsep}{6pt}}{}
\@ifundefined{aaai@absboxrule}{\newlength\aaai@absboxrule \setlength{\aaai@absboxrule}{0.6pt}}{}
\@ifundefined{aaai@abstitlebelow}{\newlength\aaai@abstitlebelow \setlength{\aaai@abstitlebelow}{0.4ex}}{}
\@ifundefined{aaai@afterabsskip}{\newlength\aaai@afterabsskip \setlength{\aaai@afterabsskip}{1ex}}{}
\@ifundefined{frontabstracttitleformat}{\newcommand{\frontabstracttitleformat}{\centering\bfseries\color{AAAIFrontAbsBorder}}}{}
\@ifundefined{frontabstracttitle}{\newcommand{\frontabstracttitle}{Abstract}}{}

% 圆角半径（可配置）
\newlength\aaai@absboxradius
\setlength{\aaai@absboxradius}{4pt}
\newcommand{\setfrontabstractboxradius}[1]{\setlength{\aaai@absboxradius}{#1}}

% 计算宽度用
\newlength\aaai@abscontentwidth
\newlength\aaai@absinnerwidth

\let\aaai@oldfrontblock\aaai@frontblock
\def\aaai@frontblock{%
  \ifaaai@hasfrontabs
    {\small
      % 1) 内容区域总宽 = \textwidth - 左/右边距
      \setlength{\aaai@abscontentwidth}{\dimexpr\textwidth-\aaai@absleft-\aaai@absright\relax}%
      % 2) 盒子内部 parbox 宽 = 内容总宽 - 2*内边距 - 2*线宽
      \setlength{\aaai@absinnerwidth}{\dimexpr
        \aaai@abscontentwidth - 2\aaai@absboxsep - 2\aaai@absboxrule\relax}%
      % 3) 精确水平定位：左边距 -> 盒子 -> 右边距
      \noindent
      \hspace*{\aaai@absleft}%
      \begin{tikzpicture}[baseline=(absbox.base)]
        \node[draw=AAAIFrontAbsBorder,
              fill=white,
              line width=\aaai@absboxrule,
              rounded corners=\aaai@absboxradius,
              inner sep=\aaai@absboxsep] (absbox)
        {\parbox[t]{\aaai@absinnerwidth}{%
           {\frontabstracttitleformat \frontabstracttitle\par}%
           \vspace{\aaai@abstitlebelow}%
           \aaai@frontabstract
        }};
      \end{tikzpicture}%
      \hspace*{\aaai@absright}%
      \par
    }%
    % 摘要块与首图之间的间距（可用 \setfrontafterabsskip 调）
    \vskip \aaai@afterabsskip
  \fi
  \ifaaai@hasfrontteaser
    \par\begingroup\centering \aaai@frontteaser \par\endgroup \vskip 1ex%
  \fi
}

\makeatother
% === END UPDATE 4+5 ===



