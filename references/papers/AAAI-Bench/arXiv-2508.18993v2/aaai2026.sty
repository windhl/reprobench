\newcommand{\frontabstracttitle}{Abstract}
\newcommand{\setfrontabstracttitle}[1]{\renewcommand{\frontabstracttitle}{##1}}

% 重新定义摘要输出块（仅覆盖摘要部分；首图逻辑保持不变）
\let\aaai@oldfrontblock\aaai@frontblock
\def\aaai@frontblock{%
  \ifaaai@hasfrontabs
    {
      \list{}{\leftmargin\aaai@absleft \rightmargin\aaai@absright}\item[]
        \begingroup
          \setlength{\fboxsep}{\aaai@absboxsep}% 盒子内边距（你之前已配置）
          \setlength{\fboxrule}{\aaai@absboxrule}% 边框线宽（你之前已配置）
          \fcolorbox{AAAIFrontAbsBorder}{white}{%
            \parbox[t]{\linewidth}{%
              {\frontabstracttitleformat \frontabstracttitle\par}%
              \vspace{\aaai@abstitlebelow}%
              \aaai@frontabstract
            }%
          }%
        \endgroup
      \endlist
    }%
    \vskip 1ex%
  \fi
  \ifaaai@hasfrontteaser
