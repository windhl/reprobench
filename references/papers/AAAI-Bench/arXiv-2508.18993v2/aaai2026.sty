\makeatletter
\@ifpackageloaded{xcolor}{}{\RequirePackage{xcolor}}

% 颜色、线宽、内边距的参数（可改）
\definecolor{aaaiFrontAbsBorderDefault}{RGB}{106,90,205} % #6A5ACD 蓝紫
\colorlet{AAAIFrontAbsBorder}{aaaiFrontAbsBorderDefault}
\newcommand{\setfrontabstractbordercolor}[1]{\colorlet{AAAIFrontAbsBorder}{#1}}

\newlength\aaai@absboxsep   \setlength{\aaai@absboxsep}{6pt}   % 盒子内边距
\newlength\aaai@absboxrule  \setlength{\aaai@absboxrule}{0.6pt} % 边框线宽
\newcommand{\setfrontabstractboxsep}[1]{\setlength{\aaai@absboxsep}{#1}}
\newcommand{\setfrontabstractboxrule}[1]{\setlength{\aaai@absboxrule}{#1}}

% 重新定义摘要输出块：仅替换 \aaai@frontblock 中摘要那几行
\let\aaai@oldfrontblock\aaai@frontblock
\def\aaai@frontblock{%
  \ifaaai@hasfrontabs
    \par\centerline{\bf Abstract}\vspace{0.5ex}%
    {\small
      \list{}{\leftmargin\aaai@absleft \rightmargin\aaai@absright}\item[]
        \begingroup
          \setlength{\fboxsep}{\aaai@absboxsep}%
          \setlength{\fboxrule}{\aaai@absboxrule}%
          \fcolorbox{AAAIFrontAbsBorder}{white}{%
            \parbox[t]{\linewidth}{\aaai@frontabstract}%
