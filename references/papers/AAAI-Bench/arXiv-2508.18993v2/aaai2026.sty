% === UPDATE 2: 把“Abstract”标题也包含进边框里 ===
\makeatletter

% 标题与正文之间的竖向间距（可调）
\newlength\aaai@abstitlebelow
\setlength{\aaai@abstitlebelow}{0.4ex}
\newcommand{\setfrontabstracttitleskip}[1]{\setlength{\aaai@abstitlebelow}{#1}}

% 标题格式（可重定义：居中/加粗/小型大写等）
\newcommand{\frontabstracttitleformat}{\centering\bfseries}
